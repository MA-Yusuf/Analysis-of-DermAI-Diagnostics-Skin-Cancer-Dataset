-- Which age and gender group has the highest incidence of malignant skin lesions?
SELECT gender, 
    CASE 
        WHEN age < 20 THEN '0-19'
        WHEN age BETWEEN 20 AND 39 THEN '20-39'
        WHEN age BETWEEN 40 AND 59 THEN '40-59'
        WHEN age BETWEEN 60 AND 79 THEN '60-79'
        ELSE '80+' 
    END AS age_group,
    COUNT(*) AS malignant_cases
FROM table1 t1
JOIN table2  t2 ON t1.patient_id = t2.patient_id
WHERE diagnostic = 'malignant'
GROUP BY gender, age_group
ORDER BY malignant_cases DESC;

-- What is the average diameter of each lesion?
SELECT diagnostic,
AVG((diameter_1 + diameter_2) / 2.0) AS avg_diameter,
COUNT(*) AS lesion_count
FROM table2
GROUP BY diagnostic
ORDER BY avg_diameter DESC;

--  Which body region is mostly affected and total number of lesion for each region?
SELECT 
    region,
    COUNT(*) AS total_lesions,
    SUM(CASE WHEN (diagnostic) = 'malignant' THEN 1 ELSE 0 END) AS malignant_lesions
FROM table2
GROUP BY region
ORDER BY total_lesions DESC;

